# Copy to .env and adjust. `pnpm db:up` starts a local Postgres matching these values.
DATABASE_URL="postgresql://devhelp:devhelp@localhost:5432/devhelp"
# Connection pool size for postgres-js (default 10).
DATABASE_POOL_MAX="10"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3001"
# Optional social login. Leave blank to use email + password only.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Content pipeline. CONTENT_DIR points at a local checkout of devhelppk/devhelp-content
# while authoring; leave unset to use the pinned tarball in .content/ (pnpm content:pull).
CONTENT_DIR=""
# Shared secret for POST /api/content/sync (re-run sync for the deployed content). openssl rand -hex 32
CONTENT_SYNC_SECRET=""

# Public URLs of the two apps (used for links between them and auth trusted origins).
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_LMS_URL="http://localhost:3001"

# Email. `log` prints to the console and keeps an in-memory outbox (tests);
# `smtp` sends to any SMTP server (pnpm db:up also starts Mailpit on :1025, UI on :8025);
# `resend` uses Resend's API. Production must be resend or smtp.
EMAIL_PROVIDER="smtp"
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="devhelp <no-reply@devhelp.pk>"
RESEND_API_KEY=""

# Object storage (certificate PDFs, later uploads). S3 API everywhere: Cloudflare R2 in
# production, MinIO locally (pnpm db:up starts it; console on http://localhost:9001).
STORAGE_DRIVER="s3"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="devhelp"
S3_ACCESS_KEY_ID="devhelp"
S3_SECRET_ACCESS_KEY="devhelp-minio"
S3_FORCE_PATH_STYLE="1"
