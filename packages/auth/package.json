{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "auth:generate": "auth generate --config src/server.ts --output ../database/src/schema/auth.ts -y",
    "lint": "eslint src --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@repo/database": "workspace:*",
    "better-auth": "^1.7.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "26.2.0",
    "auth": "^1.7.2",
    "eslint": "10.8.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
