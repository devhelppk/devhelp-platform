{
  "name": "devhelp-platform",
  "private": true,
  "description": "devhelp.pk \u2014 a free, open-source learning platform for Pakistan's software engineers and students.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web...",
    "dev:lms": "turbo run dev --filter=lms...",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:reference": "turbo run db:reference",
    "db:seed": "turbo run db:seed",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "content:pull": "pnpm --filter @repo/content pull",
    "content:check": "pnpm --filter @repo/content-schema check",
    "content:sync": "pnpm --filter @repo/content sync",
    "content:refresh": "pnpm content:pull && pnpm content:check && pnpm content:sync",
    "check-budget": "tsx scripts/check-bundle-budget.ts",
    "test:scripts": "vitest run --root scripts",
    "certificates:backfill": "pnpm --filter @repo/learning certificates:backfill"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "^4.21.0",
    "turbo": "^2.10.12",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  }
}
